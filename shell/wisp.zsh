# wisp: AI ghost-text command suggestions for zsh. Generated by `wisp init zsh`.
#
# With zsh-autosuggestions loaded first, it draws the grey suggestion text and provides the
# accept keys (right arrow, End, Ctrl-F), and wisp replaces its suggestion with the model's.
# Without it, wisp draws the ghost text and handles those keys itself.

[[ -o interactive ]] || return 0
zmodload zsh/net/socket zsh/zselect zsh/datetime || return 1
autoload -Uz add-zle-hook-widget add-zsh-hook

typeset -g _WISP_BIN=__WISP_BIN__
typeset -g _WISP_SOCKET=__WISP_SOCKET__
typeset -g _WISP_LOG=${_WISP_SOCKET:r}.log
typeset -g _WISP_FD= _WISP_CMD= _WISP_SENT_BUFFER=
typeset -gi _WISP_SEQ=0 _WISP_RETRY_AT=0
# Decided once, at load: 1 when wisp draws the ghost text itself.
typeset -gi _WISP_NATIVE=$(( ! ${+functions[_zsh_autosuggest_highlight_apply]} ))
# Native mode only: the suggested line being shown, and its highlight as zsh spells it.
typeset -g _WISP_GHOST= _WISP_HL=

# _wisp_show sets POSTDISPLAY itself, so autosuggestions must not wrap it.
(( _WISP_NATIVE )) || ZSH_AUTOSUGGEST_IGNORE_WIDGETS+=(_wisp_show)

# Sets REPLY to $1 encoded as a JSON string.
_wisp_json() {
  emulate -L zsh
  local s=${1//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//[[:cntrl:]]/}
  REPLY="\"$s\""
}

# Connects to the daemon, starting it if needed. After a failed start, waits a minute
# before trying again so a broken install does not stall every prompt.
_wisp_connect() {
  emulate -L zsh
  [[ -n $_WISP_FD ]] && return 0
  (( EPOCHSECONDS >= _WISP_RETRY_AT )) || return 1
  if ! zsocket $_WISP_SOCKET 2>/dev/null; then
    mkdir -p -m 700 ${_WISP_SOCKET:h}
    ( cd / && exec $_WISP_BIN daemon --socket $_WISP_SOCKET </dev/null >>$_WISP_LOG 2>&1 & )
    local attempt connected=0
    for attempt in {1..20}; do
      zselect -t 5
      if zsocket $_WISP_SOCKET 2>/dev/null; then
        connected=1
        break
      fi
    done
    if (( ! connected )); then
      _WISP_RETRY_AT=$(( EPOCHSECONDS + 60 ))
      print -u2 "wisp: daemon did not start, see $_WISP_LOG"
      return 1
    fi
  fi
  _WISP_FD=$REPLY
  zle -F $_WISP_FD _wisp_recv
}

_wisp_disconnect() {
  emulate -L zsh
  [[ -n $_WISP_FD ]] || return 0
  zle -F $_WISP_FD 2>/dev/null
  exec {_WISP_FD}>&-
  _WISP_FD=
}

_wisp_send() {
  emulate -L zsh
  # A daemon that just died must not kill the shell with SIGPIPE.
  trap '' PIPE
  _wisp_connect || return 1
  print -r -u $_WISP_FD -- $1 2>/dev/null || _wisp_disconnect
}

# Called by zle when the daemon replies with "<seq>\t<suggestion>".
_wisp_recv() {
  emulate -L zsh
  local line
  if ! IFS= read -r -u $1 line; then
    _wisp_disconnect
    return 0
  fi
  (( ${line%%$'\t'*} == _WISP_SEQ )) || return 0
  zle _wisp_show -- "${line#*$'\t'}"
  # Handlers run between keystrokes, so zle does not repaint on its own.
  zle -R
}

_wisp_show() {
  emulate -L zsh
  local suggestion=$1
  [[ $suggestion == "$BUFFER"* ]] && (( CURSOR == $#BUFFER )) || return 0
  if (( _WISP_NATIVE )); then
    _WISP_GHOST=$suggestion
    _wisp_ghost_render
    return 0
  fi
  _zsh_autosuggest_highlight_reset
  POSTDISPLAY=${suggestion#"$BUFFER"}
  _zsh_autosuggest_highlight_apply
}
zle -N _wisp_show

# Redraws the ghost text from _WISP_GHOST, or drops it once it no longer extends the buffer.
# Runs before every redraw, so typing along a suggestion keeps it without a flicker.
_wisp_ghost_render() {
  emulate -L zsh
  local drawn=$_WISP_HL
  if [[ -n $drawn ]]; then
    # Matched by style and memo only: zsh moves the offsets as the buffer is edited.
    region_highlight=("${(@)region_highlight:#<-> <-> ${(b)drawn}}")
    _WISP_HL=
  fi
  if [[ -n $_WISP_GHOST && $_WISP_GHOST == "$BUFFER"?* ]]; then
    POSTDISPLAY=${_WISP_GHOST#"$BUFFER"}
    # zsh before 5.9 has no memo and silently drops it after the comma.
    region_highlight+=(
      "$#BUFFER $(( $#BUFFER + $#POSTDISPLAY )) ${WISP_HIGHLIGHT_STYLE:-fg=8}, memo=wisp"
    )
    # Read back, because zsh stores the entry in its own spelling.
    _WISP_HL=${region_highlight[-1]#<-> <-> }
  else
    _WISP_GHOST=
    # Only what wisp drew: POSTDISPLAY may belong to someone else.
    [[ -n $drawn ]] && POSTDISPLAY=
  fi
}

# Before the line is accepted, so the ghost text is neither left in scrollback nor executed.
_wisp_ghost_clear() {
  emulate -L zsh
  _WISP_GHOST=
  _wisp_ghost_render
}

_wisp_ghost_at_end() {
  emulate -L zsh
  [[ -n $POSTDISPLAY && $_WISP_GHOST == "$BUFFER$POSTDISPLAY" ]] || return 1
  # In vi command mode the cursor rests on the last character, not after it.
  local last=$#BUFFER
  [[ $KEYMAP == vicmd ]] && (( last-- ))
  (( CURSOR >= last ))
}

_wisp_ghost_take() {
  emulate -L zsh
  POSTDISPLAY=
  BUFFER=$_WISP_GHOST
  (( $1 )) && CURSOR=$#BUFFER
}

_wisp_ghost_keep_to_cursor() {
  emulate -L zsh
  _WISP_GHOST=$BUFFER
  BUFFER=${BUFFER[1,CURSOR]}
}

# The wrappers below take the wrapped widget as $1. They do not `emulate`, so a user-defined
# widget still runs with the user's options.

# Accepts the whole suggestion; without one at the cursor, the key does what it always did.
_wisp_ghost_accept() {
  if _wisp_ghost_at_end; then
    _wisp_ghost_take 1
  else
    zle "$1" -- "${@:2}"
  fi
}

# Accepts up to wherever the wrapped widget moves the cursor, so the user's idea of a word
# (WORDCHARS, a custom forward-word) decides how much is taken.
_wisp_ghost_word() {
  if _wisp_ghost_at_end; then
    _wisp_ghost_take 0
    zle "$1" -- "${@:2}"
    _wisp_ghost_keep_to_cursor
  else
    zle "$1" -- "${@:2}"
  fi
}

# Wraps widgets $2.. with _wisp_ghost_$1. A widget someone else already redefined is kept
# under _wisp_orig_<name> and still runs. One function per widget, not a lookup by $WIDGET,
# so the wrapper survives another plugin renaming it.
_wisp_wrap() {
  emulate -L zsh
  local kind=$1 widget orig
  shift
  for widget; do
    case ${widgets[$widget]-} in
      builtin) orig=.$widget ;;
      # Sourced twice: already wrapped.
      user:_wisp_${kind}_$widget) continue ;;
      user:*)
        orig=_wisp_orig_$widget
        zle -N $orig ${widgets[$widget]#user:}
        ;;
      *) continue ;;
    esac
    eval "_wisp_${kind}_${widget}() { _wisp_ghost_${kind} ${(q)orig} \"\$@\" }"
    zle -N $widget _wisp_${kind}_$widget
  done
}

if (( _WISP_NATIVE )); then
  _wisp_wrap accept forward-char end-of-line vi-forward-char vi-end-of-line vi-add-eol
  _wisp_wrap word forward-word emacs-forward-word vi-forward-word
  add-zle-hook-widget line-finish _wisp_ghost_clear
fi

_wisp_line_changed() {
  emulate -L zsh
  if [[ $BUFFER != "$_WISP_SENT_BUFFER" ]]; then
    _WISP_SENT_BUFFER=$BUFFER
    (( ++_WISP_SEQ ))
    if (( $#BUFFER && CURSOR == $#BUFFER )); then
      _wisp_json $BUFFER
      _wisp_send "{\"t\":\"req\",\"seq\":$_WISP_SEQ,\"buf\":$REPLY}"
    fi
    # A line emptied by the user asks for nothing, so it shows nothing either.
    (( $#BUFFER )) || _WISP_GHOST=
  fi
  (( _WISP_NATIVE )) && _wisp_ghost_render
  return 0
}
add-zle-hook-widget line-pre-redraw _wisp_line_changed

_wisp_preexec() {
  _WISP_CMD=$1
}
add-zsh-hook preexec _wisp_preexec

_wisp_precmd() {
  local exit_status=$?
  emulate -L zsh
  local cmd cwd pane histfile term
  _wisp_json $_WISP_CMD; cmd=$REPLY
  _wisp_json $PWD; cwd=$REPLY
  _wisp_json ${WEZTERM_PANE:-}; pane=$REPLY
  _wisp_json ${HISTFILE:-}; histfile=$REPLY
  # Everything the daemon needs to read this shell's screen; it picks the source.
  _wisp_json ${TMUX:-}; term="\"tmux\":$REPLY"
  _wisp_json ${TMUX_PANE:-}; term+=",\"tmux_pane\":$REPLY"
  term+=",\"wezterm_pane\":$pane"
  _wisp_json ${KITTY_WINDOW_ID:-}; term+=",\"kitty_window\":$REPLY"
  _wisp_json ${KITTY_LISTEN_ON:-}; term+=",\"kitty_listen\":$REPLY"
  _wisp_json ${WISP_SCREEN_CMD:-}; term+=",\"screen_cmd\":$REPLY"
  _WISP_CMD= _WISP_SENT_BUFFER= _WISP_GHOST= _WISP_HL=
  (( ++_WISP_SEQ ))
  _wisp_send "{\"t\":\"done\",\"seq\":$_WISP_SEQ,\"cmd\":$cmd,\"status\":$exit_status,\"cwd\":$cwd,\"pane\":$pane,\"histfile\":$histfile,\"term\":{$term}}"
}
# First, so $? is still the status of the command that just finished.
typeset -ga precmd_functions
precmd_functions=(_wisp_precmd "${precmd_functions[@]}")
